# rum-ingest configuration (copy to .env for local dev; set on Cloud Run in prod).

# GCP project (on Cloud Run this is provided automatically via ADC).
GOOGLE_CLOUD_PROJECT=

# --- /metrics auth (design D10) ---
# Comma-separated emails allowed to read analytics. Empty => everyone is 403'd.
ALLOWLIST_EMAILS=ray@example.com
# Dashboard origin permitted by CORS.
DASH_ORIGIN=https://dash.ray-shen.me

# --- /rollup auth (task 5.3) ---
# The Cloud Scheduler service-account email whose OIDC token is accepted.
SCHEDULER_SA_EMAIL=
# The audience the OIDC token must target (usually the rollup endpoint URL).
ROLLUP_AUDIENCE=
# Optional shared token for manual rollup invocation (leave empty to disable).
ROLLUP_ADMIN_TOKEN=

# --- geo (design D6) ---
GEOLITE_DB_PATH=geodata/GeoLite2-City.mmdb
# Which X-Forwarded-For position holds the trusted client IP: last | first | <int-from-right>
TRUSTED_XFF_POSITION=last

# --- ingest tuning ---
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
ENGAGED_MS_THRESHOLD=10000
SITE_CACHE_TTL_MS=300000

# --- rollup / metrics ---
BACKFILL_DAYS=7
METRICS_WRITE_THROUGH=true

PORT=8080
