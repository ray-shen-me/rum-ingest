{
  "name": "rum-ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RUM ingest + metrics + rollup service (Cloud Run, api.ray-shen.me)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed-site.ts",
    "rollup:local": "tsx scripts/run-rollup.ts",
    "test": "node --import tsx/esm --test src/validate.test.ts src/lib/write.test.ts src/lib/aggregate.test.ts"
  },
  "dependencies": {
    "@maxmind/geoip2-node": "^5.0.0",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "google-auth-library": "^9.15.0",
    "isbot": "^5.1.17",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
